[
  {
    "name": "theme_info",
    "theme_name": "MaxFoot Dawn",
    "theme_version": "1.0.0",
    "theme_author": "MaxFoot",
    "theme_documentation_url": "https://maxfoot.bike/themes/maxfoot-dawn",
    "theme_support_url": "https://maxfoot.bike/support"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "PNG with transparent background, recommended height 52px"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height (desktop)",
        "min": 24,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 52
      },
      {
        "type": "range",
        "id": "logo_height_mobile",
        "label": "Logo height (mobile)",
        "min": 20,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "checkbox",
        "id": "logo_invert",
        "label": "Invert logo (for dark backgrounds)",
        "default": false
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand palette"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary",
        "default": "#121212"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#FFC000"
      },
      {
        "type": "color",
        "id": "color_accent_dark",
        "label": "Accent dark",
        "default": "#E6AC00"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_bg_soft",
        "label": "Background soft",
        "default": "#F7F7F5"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_text_soft",
        "label": "Text soft",
        "default": "#6A6A6A"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#E5E5E5"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "default": "#1F7A4D"
      },
      {
        "type": "color",
        "id": "color_danger",
        "label": "Danger / Sale",
        "default": "#C83A3A"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Font families (Google Fonts)"
      },
      {
        "type": "text",
        "id": "font_display",
        "label": "Display font",
        "default": "Big Shoulders Display"
      },
      {
        "type": "text",
        "id": "font_body",
        "label": "Body font",
        "default": "Inter Tight"
      },
      {
        "type": "text",
        "id": "font_mono",
        "label": "Monospace font",
        "default": "JetBrains Mono"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base font size",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page max width",
        "min": 1200,
        "max": 1800,
        "step": 40,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "section_padding_y",
        "label": "Section vertical padding",
        "min": 32,
        "max": 128,
        "step": 8,
        "unit": "px",
        "default": 80
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Default border radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 8
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "header",
        "content": "Footer social links"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "Twitter / X URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32x32 PNG or ICO"
      }
    ]
  },
  {
    "name": "Currency format",
    "settings": [
      {
        "type": "header",
        "content": "Money format"
      },
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Show currency codes",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_type_drawer",
        "label": "Use cart drawer (vs page)",
        "default": false
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "default": "299"
      },
      {
        "type": "text",
        "id": "free_shipping_message",
        "label": "Free shipping bar message",
        "default": "Add {amount} more for FREE shipping!"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable scroll animations",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_marquee",
        "label": "Enable announcement bar marquee",
        "default": true
      }
    ]
  }
]
