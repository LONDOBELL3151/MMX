<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0,height=device-height,minimum-scale=1.0">
  <meta name="theme-color" content="{{ settings.color_primary }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- render 'meta-tags' -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ settings.font_display | replace: ' ', '+' }}:wght@400;700;800;900&family={{ settings.font_body | replace: ' ', '+' }}:wght@400;500;600;700&family={{ settings.font_mono | replace: ' ', '+' }}:wght@400;500;700&display=swap">

  {{ 'maxfoot-base.css' | asset_url | stylesheet_tag }}
  {{ 'maxfoot-components.css' | asset_url | stylesheet_tag }}
  {{ 'maxfoot-responsive.css' | asset_url | stylesheet_tag }}

  <style>
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-dark: {{ settings.color_accent_dark }};
      --color-bg: {{ settings.color_bg }};
      --color-bg-soft: {{ settings.color_bg_soft }};
      --color-text: {{ settings.color_text }};
      --color-text-soft: {{ settings.color_text_soft }};
      --color-border: {{ settings.color_border }};
      --color-success: {{ settings.color_success }};
      --color-danger: {{ settings.color_danger }};
      --font-display: '{{ settings.font_display }}', system-ui, sans-serif;
      --font-body: '{{ settings.font_body }}', system-ui, sans-serif;
      --font-mono: '{{ settings.font_mono }}', monospace;
      --font-size-base: {{ settings.font_size_base }}px;
      --page-width: {{ settings.page_width }}px;
      --section-padding-y: {{ settings.section_padding_y }}px;
      --radius-sm: 4px;
      --radius-md: {{ settings.border_radius }}px;
      --radius-lg: {{ settings.border_radius | times: 2 }}px;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
      --shadow-lg: 0 12px 32px rgba(0,0,0,0.12);
      --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
  </style>
</head>

<body class="template-{{ template | replace: '.', '-' | handleize }}">
  <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t: default: 'Skip to content' }}</a>

  {%- sections 'header-group' -%}

  <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}

  {%- section 'mobile-menu' -%}

  {%- render 'cart-drawer' -%}

  <script src="{{ 'maxfoot.js' | asset_url }}" defer></script>
</body>
</html>