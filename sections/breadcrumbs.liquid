{%- comment -%}
  Breadcrumbs wrapper section.
  Renders the breadcrumbs snippet. Add this section in theme editor to
  place breadcrumbs as a standalone block on a page. If unused, the
  snippet can also be embedded directly via {% render 'breadcrumbs' %}.
{%- endcomment -%}

<section class="section breadcrumbs-section" {{ section.shopify_attributes }}>
  <div class="container">
    {% render 'breadcrumbs' %}
  </div>
</section>

{% schema %}
{
  "name": "Breadcrumbs",
  "tag": "section",
  "class": "section-breadcrumbs",
  "settings": [],
  "presets": [
    { "name": "Breadcrumbs" }
  ]
}
{% endschema %}
