{%- liquid
  assign s = section.settings
  assign product_count = 0
  for b in section.blocks
    if b.type == 'product_slot'
      assign product_count = product_count | plus: 1
    endif
  endfor
-%}

<section class="section compare-section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="compare__head">
      <h1 class="section__title">{{ s.heading | default: 'Compare Models' }}</h1>
      {%- if s.subheading != blank -%}
        <p class="section__sub">{{ s.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if product_count == 0 -%}
      <div class="compare__empty">
        <p>Add product slots below to start comparing. Up to {{ s.max_products | default: 4 }} models.</p>
      </div>
    {%- else -%}
      <div class="compare__wrap">
        <table class="compare-table" data-compare-table>
          <thead>
            <tr>
              <th class="compare-table__label-col">&nbsp;</th>
              {%- for block in section.blocks -%}
                {%- if block.type != 'product_slot' -%}{%- continue -%}{%- endif -%}
                {%- assign p = block.settings.product -%}
                <th class="compare-table__product-col" {{ block.shopify_attributes }} data-product-col>
                  {%- if p != blank -%}
                    <a href="{{ p.url }}" class="compare-table__product-link">
                      {%- if p.featured_image -%}
                        <img src="{{ p.featured_image | image_url: width: 240 }}" alt="{{ p.title | escape }}" loading="lazy" width="120" height="120">
                      {%- endif -%}
                      <strong class="compare-table__product-title">{{ p.title }}</strong>
                    </a>
                    <div class="compare-table__product-price">{{ p.price | money }}</div>
                  {%- else -%}
                    <span class="compare-table__placeholder">Select a product</span>
                  {%- endif -%}
                </th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for spec_block in section.blocks -%}
              {%- if spec_block.type == 'spec_row' -%}
                {%- assign spec = spec_block.settings -%}
                <tr data-spec-row data-tag-prefix="{{ spec.tag_prefix }}" data-compare-direction="{{ spec.direction | default: 'high' }}">
                  <th scope="row" class="compare-table__label">
                    <strong>{{ spec.label | default: 'Specification' }}</strong>
                    {%- if spec.tooltip != blank -%}
                      <span class="compare-table__tooltip" title="{{ spec.tooltip | escape }}">?</span>
                    {%- endif -%}
                  </th>
                  {%- for product_block in section.blocks -%}
                    {%- if product_block.type != 'product_slot' -%}{%- continue -%}{%- endif -%}
                    {%- assign p = product_block.settings.product -%}
                    {%- assign spec_number = 0 -%}
                    {%- assign spec_unit = '' -%}
                    {%- if p != blank and spec.tag_prefix != blank -%}
                      {%- for tag in p.tags -%}
                        {%- assign tag_downcase = tag | downcase -%}
                        {%- assign prefix_downcase = spec.tag_prefix | downcase -%}
                        {%- if tag_downcase | starts_with: prefix_downcase -%}
                          {%- comment -%}tag like 'range_60mi' -> split on _ after prefix{%- endcomment -%}
                          {%- assign after_prefix = tag | remove_first: spec.tag_prefix -%}
                          {%- assign after_prefix = after_prefix | lstrip -%}
                          {%- if after_prefix == '' -%}
                            {%- comment -%}tag is exactly the prefix, use 1 as value{%- endcomment -%}
                            {%- assign spec_number = 1 -%}
                          {%- elsif after_prefix contains '_' -%}
                            {%- assign parts = after_prefix | split: '_' -%}
                            {%- assign num_part = parts[0] -%}
                            {%- assign unit_part = parts[1] -%}
                            {%- assign spec_number = num_part | times: 1 -%}
                            {%- assign spec_unit = unit_part -%}
                          {%- else -%}
                            {%- assign spec_number = after_prefix | times: 1 -%}
                          {%- endif -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    <td data-spec-value="{{ spec_number }}" data-spec-unit="{{ spec_unit }}" {{ product_block.shopify_attributes }}>
                      {%- if p == blank -%}
                        <span class="compare-table__dash">&mdash;</span>
                      {%- elsif spec.tag_prefix == 'price' -%}
                        {{ p.price | money }}
                      {%- elsif spec_number > 0 -%}
                        <strong>{{ spec_number }}</strong>{% if spec_unit != blank %} <span class="compare-table__unit">{{ spec_unit }}</span>{% endif %}
                      {%- else -%}
                        <span class="compare-table__dash">&mdash;</span>
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Compare models",
  "tag": "section",
  "class": "section-compare",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare Models"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Side-by-side specs to help you pick the right ride."
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Max products to compare",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "product_slot",
      "name": "Product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    },
    {
      "type": "spec_row",
      "name": "Spec row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Spec label (e.g. Range, Top Speed)",
          "default": "Range"
        },
        {
          "type": "text",
          "id": "tag_prefix",
          "label": "Product tag prefix (e.g. 'range', 'battery', 'top_speed')",
          "info": "Tags must follow the format 'prefix_value' or 'prefix_number_unit' e.g. range_60mi, battery_48v, top_speed_28mph"
        },
        {
          "type": "text",
          "id": "tooltip",
          "label": "Tooltip (optional)"
        },
        {
          "type": "select",
          "id": "direction",
          "label": "Higher is better?",
          "options": [
            { "value": "high", "label": "Higher is better" },
            { "value": "low", "label": "Lower is better (e.g. price, weight)" }
          ],
          "default": "high"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compare models",
      "blocks": [
        { "type": "product_slot" },
        { "type": "product_slot" },
        { "type": "spec_row", "settings": { "label": "Price", "tag_prefix": "price", "direction": "low" } },
        { "type": "spec_row", "settings": { "label": "Range", "tag_prefix": "range", "direction": "high" } },
        { "type": "spec_row", "settings": { "label": "Top Speed", "tag_prefix": "top_speed", "direction": "high" } },
        { "type": "spec_row", "settings": { "label": "Battery", "tag_prefix": "battery", "direction": "high" } },
        { "type": "spec_row", "settings": { "label": "Motor", "tag_prefix": "motor", "direction": "high" } },
        { "type": "spec_row", "settings": { "label": "Weight", "tag_prefix": "weight", "direction": "low" } },
        { "type": "spec_row", "settings": { "label": "Payload", "tag_prefix": "payload", "direction": "high" } },
        { "type": "spec_row", "settings": { "label": "Wheels", "tag_prefix": "wheels", "direction": "high" } }
      ]
    }
  ]
}
{% endschema %}
