{%- liquid
  assign s = section.settings
-%}

<section class="contact-form-section section" id="hours" {{ section.shopify_attributes }}>
  <div class="container contact-form-grid">
    <div class="contact-form__form">
      <h2 class="section__title">{{ s.heading | default: 'Send us a message' }}</h2>
      {%- if s.subheading != blank -%}
        <p class="section__sub">{{ s.subheading }}</p>
      {%- endif -%}

      {% form 'contact', id: 'ContactForm' %}
        {%- if form.posted_successfully? -%}
          <div class="form-success">Thanks! We typically reply within 4 hours.</div>
        {%- elsif form.errors -%}
          <div class="form-errors">Please check the highlighted fields.</div>
        {%- endif -%}

        <div class="form-row">
          <label>Your name <em>*</em></label>
          <input type="text" name="contact[name]" required value="{{ form.name }}">
        </div>
        <div class="form-row">
          <label>Email <em>*</em></label>
          <input type="email" name="contact[email]" required value="{{ form.email }}">
        </div>
        <div class="form-row">
          <label>Order number (optional)</label>
          <input type="text" name="contact[order_number]" placeholder="#MF-12345">
        </div>
        <div class="form-row">
          <label>What can we help with? <em>*</em></label>
          <select name="contact[subject]" required>
            <option value="">Choose a topic</option>
            <option>Pre-purchase question</option>
            <option>Order status</option>
            <option>Returns & trial</option>
            <option>Warranty claim</option>
            <option>Wholesale</option>
            <option>Press</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-row">
          <label>Message <em>*</em></label>
          <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg form-submit">Send Message</button>
        <div class="form-note">Your info stays with us. We never share or sell. Average reply time: under 4 hours.</div>
      {% endform %}
    </div>

    <aside class="contact-form__hours">
      <h3>{{ s.hours_heading | default: 'Support Hours (EST)' }}</h3>
      <table class="hours-table">
        {%- for block in section.blocks -%}
          {%- if block.type == 'hours_row' -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.day }}</td>
              <td>{{ block.settings.hours }}</td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </table>

      <div class="hours-note">
        {%- if s.hours_note != blank -%}
          {{ s.hours_note }}
        {%- else -%}
          After hours? Email <a href="mailto:{{ shop.email }}">{{ shop.email }}</a> and we'll reply by 9am the next business day.
        {%- endif -%}
      </div>

      {%- if s.show_map -%}
        <div class="contact-map">
          <iframe src="{{ s.map_url | default: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3077.123!2d-119.8135!3d39.5296!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMznCsDMxJzQ2LjAiTiAxMTnCsDQ4JzQ4LjYiVw!5e0!3m2!1sen!2sus!4v1234567890' }}" width="100%" height="220" style="border:0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      {%- endif -%}
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Form heading",
      "default": "Send us a message"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Form subheading"
    },
    {
      "type": "text",
      "id": "hours_heading",
      "label": "Hours heading",
      "default": "Support Hours (EST)"
    },
    {
      "type": "richtext",
      "id": "hours_note",
      "label": "Hours note"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Show map embed",
      "default": true
    },
    {
      "type": "url",
      "id": "map_url",
      "label": "Custom map URL"
    }
  ],
  "blocks": [
    {
      "type": "hours_row",
      "name": "Hours row",
      "settings": [
        {
          "type": "text",
          "id": "day",
          "label": "Day",
          "default": "Monday"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Hours",
          "default": "9am - 7pm"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}{% endschema %}