{% assign s = section.settings %}

<section class="section section--faq section--soft" {{ section.shopify_attributes }}>
  <div class="container faq-grid">
    <div class="faq-head">
      <h2 class="section__title">{{ s.heading | default: 'Before you buy' }}</h2>
      {%- if s.subheading != blank -%}
        <p class="section__sub">{{ s.subheading }}</p>
      {%- endif -%}
      {%- if s.cta_text != blank -%}
        <a href="{{ s.cta_link | default: '/pages/contact' }}" class="btn btn--outline">{{ s.cta_text }} {% render 'icon', icon: 'arrow-right' }}</a>
      {%- endif -%}
    </div>
    <div class="faq-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary class="faq__q">
              {{ block.settings.question }}
              <span class="faq__icon">{% render 'icon', icon: 'plus' %}</span>
            </summary>
            <div class="faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before you buy"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Still have questions?"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}{% endschema %}
