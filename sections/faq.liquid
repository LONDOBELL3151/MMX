{%- liquid
  assign s = section.settings
-%}

<section class="section section--faq section--soft" {{ section.shopify_attributes }}>
  <div class="container faq-grid">
    <div class="faq-head">
      <h2 class="section__title">{{ s.heading | default: 'Before you buy' }}</h2>
      {%- if s.subheading != blank -%}
        <p class="section__sub">{{ s.subheading }}</p>
      {%- endif -%}
      {%- if s.cta_text != blank -%}
        <a href="{{ s.cta_link | default: '/pages/contact' }}" class="btn btn--outline">{{ s.cta_text }} {% render 'icon', icon: 'arrow-right' }}</a>
      {%- endif -%}
    </div>
    <div class="faq-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'question' -%}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary class="faq__q">
              {{ block.settings.question }}
              <span class="faq__icon">{% render 'icon', icon: 'plus' %}</span>
            </summary>
            <div class="faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you buy" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Still have questions?" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "question", "settings": { "question": "Is assembly really required?", "answer": "<p>Yes — but it's 30 minutes with the included tool kit. We made a <a href='/pages/contact'>step-by-step video</a> that walks you through it. If you'd rather not, your local bike shop can usually do it for $50-80.</p>" } },
      { "type": "question", "settings": { "question": "Are MaxFoot batteries safe?", "answer": "<p>All MaxFoot batteries are UL 2849 certified — the same standard Tesla and major automakers use. We were the first US e-trike brand to complete the certification. No thermal events in 4+ years and 50,000+ riders.</p>" } },
      { "type": "question", "settings": { "question": "How does the 14-day trial work?", "answer": "<p>Order it. Ride it for 14 days. If you don't love it, call us. We email a prepaid return label. You drop it at any UPS store. We refund the full purchase price — no restocking fees, no awkward questions.</p>" } },
      { "type": "question", "settings": { "question": "What's the warranty?", "answer": "<p>2 years, bumper-to-bumper. Frame, battery, motor, controller, display — all of it. Free shipping both ways. Average repair turnaround: 4 business days. Handled by our Reno, NV team.</p>" } },
      { "type": "question", "settings": { "question": "Can I ride a trike if I've never ridden one before?", "answer": "<p>Absolutely. Step-thru frames are designed for first-timers. Most of our riders are 60+ or have never been on an e-bike. We include a 1-on-1 video call with a real technician when your trike arrives.</p>" } }
    ]
  },
  "presets": [
    { "name": "FAQ" }
  ]
}
{% endschema %}