{%- liquid
  assign g = section.settings
-%}

{%- if g.show_announcement -%}
  {% sections 'announcement-bar' %}
{%- endif -%}

{% sections 'header' %}

{% sections 'mobile-menu' %}

{% schema %}
{
  "name": "Header group",
  "tag": "section",
  "class": "section-header-group",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    }
  ]
}
{% endschema %}