{% assign threshold_cents = settings.free_shipping_threshold | times: 100 %}
{%- liquid
  assign s = section.settings
-%}

<section class="cart-section section" {{ section.shopify_attributes }}>
  <div class="container">
    <h1 class="section__title cart-section__title">{{ s.heading | default: 'Your Cart' }}</h1>
    {% render 'breadcrumbs' %}

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        {% render 'icon', icon: 'cart', size: 64 %}
        <h2>Your cart is empty</h2>
        <p>Looks like you haven't added anything yet. Let's fix that.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--lg">Shop all eBikes</a>
        <div class="cart-empty__links">
          <a href="{{ routes.collections_url }}/electric-trikes">Electric Trikes</a>
          <a href="{{ routes.collections_url }}/ebikes">eBikes</a>
          <a href="{{ routes.collections_url }}/accessories">Accessories</a>
        </div>
      </div>
    {%- else -%}
      <div class="cart-layout">
        <div class="cart-items">
          {%- if s.show_free_shipping_bar -%}
            {% render 'free-shipping-bar' %}
          {%- endif -%}

          <form action="{{ routes.cart_url }}" method="post" novalidate>
            <table class="cart-table">
              <thead>
                <tr>
                  <th colspan="2">Product</th>
                  <th>Qty</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                {%- for item in cart.items -%}
                  <tr class="cart-item" data-line="{{ forloop.index }}">
                    <td class="cart-item__img">
                      <a href="{{ item.url }}">
                        {%- if item.image -%}
                          <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy">
                        {%- endif -%}
                      </a>
                    </td>
                    <td class="cart-item__info">
                      <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                      {%- unless item.product_has_only_default_variant -%}
                        <div class="cart-item__variant">{{ item.variant.title }}</div>
                      {%- endunless -%}
                      <div class="cart-item__price-each">{{ item.final_line_price | divided_by: item.quantity | money }} each</div>
                      <div class="cart-item__actions">
                        <a href="#" data-remove="{{ forloop.index }}">Remove</a>
                        <a href="#">Save for later</a>
                      </div>
                    </td>
                    <td class="cart-item__qty">
                      <div class="qty-control">
                        <button type="button" data-qty="dec" data-line="{{ forloop.index }}">{% render 'icon', icon: 'minus' %}</button>
                        <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line="{{ forloop.index }}" data-cart-qty>
                        <button type="button" data-qty="inc" data-line="{{ forloop.index }}">{% render 'icon', icon: 'plus' %}</button>
                      </div>
                    </td>
                    <td class="cart-item__total"><strong>{{ item.final_line_price | money }}</strong></td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            <div class="cart-actions">
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost">Continue shopping</a>
              <button type="submit" name="update" class="btn btn--outline">Update cart</button>
            </div>
          </form>
        </div>

        <aside class="cart-summary">
          <h3>{{ 'cart.general.order_summary' | t: default: 'Order Summary' }}</h3>

          <div class="summary__row">
            <span>{{ 'cart.general.subtotal' | t: default: 'Subtotal' }} ({{ cart.item_count }} items)</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="summary__row summary__row--discount">
                <span>{{ discount.title }}</span>
                <strong>−{{ discount.total_allocated_amount | money }}</strong>
              </div>
            {%- endfor -%}
          {%- endif -%}

          <div class="summary__row">
            <span>{{ 'cart.general.shipping' | t: default: 'Shipping' }}</span>
            <strong>{% if cart.total_price >= threshold_cents %}FREE{% else %}{{ settings.cart.shipping_price | default: '$199.00' }}{% endif %}</strong>
          </div>

          <div class="summary__row">
            <span>{{ 'cart.general.tax' | t: default: 'Estimated tax' }}</span>
            <strong>{{ cart.tax_price | money }}</strong>
          </div>

          <div class="summary__divider"></div>

          <div class="summary__total">
            <span>Total</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>

          {% form 'cart', cart, class: 'summary__coupon' %}
            <input type="text" name="coupon" placeholder="{{ 'cart.general.coupon' | t: default: 'Discount code' }}">
            <button type="submit" name="apply">Apply</button>
          {% endform %}

          <form action="{{ routes.checkout_url }}" method="post">
            <button type="submit" name="checkout" class="btn btn--primary btn--lg btn--block summary__cta">
              <span>Secure Checkout</span>
              {% render 'icon', icon: 'lock', size: 16 %}
            </button>
          </form>

          <div class="summary__note">
            <strong>SSL secured</strong> · 256-bit encryption<br>
            or pay with Affirm: 4 × {{ cart.total_price | divided_by: 4 | money }}, 0% APR
          </div>

          {%- if s.show_trust -%}
            <div class="summary__trust">
              <div class="summary__trust-item">{% render 'icon', icon: 'truck', size: 16 %} Free 14-Day Returns</div>
              <div class="summary__trust-item">{% render 'icon', icon: 'shield', size: 16 %} 2-Year Warranty Included</div>
              <div class="summary__trust-item">{% render 'icon', icon: 'check', size: 16 %} UL 2849 Certified Battery</div>
              <div class="summary__trust-item">{% render 'icon', icon: 'lock', size: 16 %} Ships from US Warehouse</div>
            </div>
          {%- endif -%}
        </aside>
      </div>

      {%- if s.show_recommendations -%}
        <div class="cart-recommendations">
          <h2 class="section__title">You Might Also Need</h2>
          <div class="products products--grid products--3">
            {%- assign accessory_collection = collections[s.accessory_collection] -%}
            {%- if accessory_collection != blank -%}
              {%- for product in accessory_collection.products limit: 3 -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Cart" },
    { "type": "checkbox", "id": "show_free_shipping_bar", "label": "Show free shipping bar", "default": true },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust signals below checkout", "default": true },
    { "type": "checkbox", "id": "show_recommendations", "label": "Show 'You might also need'", "default": true },
    { "type": "collection", "id": "accessory_collection", "label": "Accessory collection" }
  ],
  "presets": [
    { "name": "Main cart" }
  ]
}
{% endschema %}
