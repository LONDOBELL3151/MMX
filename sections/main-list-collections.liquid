{%- liquid
  assign s = section.settings
-%}

<section class="section list-collections" {{ section.shopify_attributes }}>
  <div class="container">
    <h1 class="section__title">{{ s.heading | default: 'All collections' }}</h1>
    <div class="collections-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-card">
          {%- if collection.image -%}
            <div class="collection-card__media" style="background-image:url({{ collection.image | image_url: width: 600 }})"></div>
          {%- else -%}
            <div class="collection-card__media collection-card__media--placeholder">{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
          <div class="collection-card__body">
            <h3 class="collection-card__title">{{ collection.title }}</h3>
            <p class="collection-card__count">{{ collection.products_count }} products</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" }
  ],
  "presets": [
    { "name": "Collections list" }
  ]
}
{% endschema %}