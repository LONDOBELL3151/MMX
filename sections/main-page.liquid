{%- liquid
  assign s = section.settings
-%}

<section class="section page-content" {{ section.shopify_attributes }}>
  <div class="container page-content__inner">
    <h1 class="section__title">{{ page.title }}</h1>
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section-main-page",
  "settings": [],
  "presets": [
    { "name": "Page" }
  ]
}
{% endschema %}
