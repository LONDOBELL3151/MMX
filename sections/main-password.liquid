{%- liquid
  assign s = section.settings
-%}

<section class="section password-page" {{ section.shopify_attributes }}>
  <div class="container password-page__inner">
    {%- if shop.password_message != blank -%}
      <div class="password-page__message">{{ shop.password_message }}</div>
    {%- endif -%}
    {%- form 'customer', id: 'password-login' -%}
      <h2>{{ 'customer.login.title' | t: default: 'Enter store password' }}</h2>
      <input type="password" name="password" placeholder="{{ 'customer.login.password' | t: default: 'Password' }}" required>
      <button type="submit" class="btn btn--primary">{{ 'customer.login.submit' | t: default: 'Enter' }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section-main-password",
  "settings": [],
  "presets": [
    { "name": "Password" }
  ]
}
{% endschema %}