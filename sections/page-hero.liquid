{%- liquid
  assign s = section.settings
-%}

<section class="page-hero" {{ section.shopify_attributes }}>
  <div class="container page-hero__inner">
    {%- if s.eyebrow != blank -%}
      <span class="page-hero__eyebrow">{{ s.eyebrow }}</span>
    {%- endif -%}
    <h1 class="page-hero__title">
      {%- if s.title != blank -%}
        {{ s.title }}
      {%- else -%}
        Built by riders, for riders.
      {%- endif -%}
    </h1>
    {%- if s.subtitle != blank -%}
      <p class="page-hero__sub">{{ s.subtitle }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "tag": "section",
  "class": "section-page-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        { "value": "yellow", "label": "Yellow" },
        { "value": "black", "label": "Black" },
        { "value": "soft", "label": "Soft" }
      ],
      "default": "yellow"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    { "name": "Page hero" }
  ]
}
{% endschema %}
