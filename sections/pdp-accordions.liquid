{%- liquid
  assign s = section.settings
  assign product = closest.product
-%}

<section class="section pdp-accordions" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="accordions">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="accordion__title">
              {{ block.settings.title }}
              <span class="accordion__icon">{% render 'icon', icon: 'plus' %}</span>
            </summary>
            <div class="accordion__content">{{ block.settings.content }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product accordions",
  "tag": "section",
  "class": "section-pdp-accordions",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Details" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "title": "What's in the box", "content": "<ul><li>MF-30 Electric Trike (fully assembled)</li><li>48V 20Ah battery with 2 keys</li><li>Fast charger (5A)</li><li>Front basket</li><li>Side mirrors (2)</li><li>Tool kit & manual</li><li>14-day trial card</li></ul>" } },
      { "type": "item", "settings": { "title": "Specs", "content": "<p>Full spec sheet available in the PDF download.</p>" } },
      { "type": "item", "settings": { "title": "Shipping & returns", "content": "<p>Ships free from our Reno, NV warehouse. Delivery in 3-5 business days via UPS. 14-day free trial - return for any reason, no restocking fees.</p>" } },
      { "type": "item", "settings": { "title": "Warranty", "content": "<p>2 years, bumper-to-bumper. Covers frame, battery, motor, controller, display. Free shipping both ways. Average repair turnaround: 4 business days.</p>" } },
      { "type": "item", "settings": { "title": "Care & maintenance", "content": "<p>Charge the battery at least once a month. Keep tires inflated to 35 psi. Wipe down after wet rides. Annual inspection recommended.</p>" } }
    ]
  }
}
{% endschema %}
