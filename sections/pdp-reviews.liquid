{%- liquid
  assign s = section.settings
-%}

<section class="section pdp-reviews" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section__head">
      <h2 class="section__title">{{ s.heading | default: 'What owners say' }}</h2>
    </div>

    {%- assign pdp_rating = 0.0 -%}
    {%- assign pdp_rating_count = 0 -%}
    {%- if product.metafields.judgeme.rating -%}
      {%- if product.metafields.judgeme.rating.value -%}
        {%- assign pdp_rating = product.metafields.judgeme.rating.value | times: 1.0 -%}
      {%- else -%}
        {%- assign pdp_rating = product.metafields.judgeme.rating | times: 1.0 -%}
      {%- endif -%}
      {%- assign pdp_rating_count = product.metafields.judgeme.review_count | default: 0 -%}
    {%- elsif product.metafields.reviews.rating.value -%}
      {%- assign pdp_rating = product.metafields.reviews.rating.value | times: 1.0 -%}
      {%- assign pdp_rating_count = product.metafields.reviews.rating_count | default: 0 -%}
    {%- elsif product.metafields.loox.avg_rating -%}
      {%- assign pdp_rating = product.metafields.loox.avg_rating | times: 1.0 -%}
      {%- assign pdp_rating_count = product.metafields.loox.num_reviews | default: 0 -%}
    {%- elsif product.metafields.yotpo.reviews_average -%}
      {%- assign pdp_rating = product.metafields.yotpo.reviews_average | times: 1.0 -%}
      {%- assign pdp_rating_count = product.metafields.yotpo.reviews_count | default: 0 -%}
    {%- endif -%}

    {%- if pdp_rating > 0 -%}
      <div class="reviews-summary">
        <div class="reviews-summary__big">{{ pdp_rating }}</div>
        {% render 'stars', rating: pdp_rating %}
        <div class="reviews-summary__count">Based on {{ pdp_rating_count }} reviews</div>
      </div>
    {%- endif -%}

    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="review" {{ block.shopify_attributes }}>
            <div class="review__rating">{% render 'stars', rating: block.settings.rating %}</div>
            <h3 class="review__title">{{ block.settings.title }}</h3>
            <p class="review__body">{{ block.settings.body }}</p>
            <div class="review__author">
              <strong>{{ block.settings.author }}</strong>
              <span>{{ block.settings.meta }}</span>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if s.show_load_more -%}
      <div class="section__cta">
        <a href="{{ s.load_more_link | default: '#' }}" class="btn btn--outline btn--lg">{{ s.load_more_label | default: 'See all reviews' }} {% render 'icon', icon: 'arrow-right' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section-pdp-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What owners say"
    },
    {
      "type": "checkbox",
      "id": "show_load_more",
      "label": "Show 'See all' button",
      "default": true
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load more label",
      "default": "See all reviews"
    },
    {
      "type": "url",
      "id": "load_more_link",
      "label": "Load more link"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review body"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta (e.g. Verified · Owner)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
