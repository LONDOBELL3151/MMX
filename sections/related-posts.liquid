{%- liquid
  assign s = section.settings
  assign blog = blogs[s.blog] | default: blogs['news']
-%}

<section class="related-posts section" {{ section.shopify_attributes }}>
  <div class="container">
    <h2 class="section__title">{{ s.heading | default: 'More buying guides' }}</h2>
    <div class="related-grid">
      {%- assign count = 0 -%}
      {%- for other in blog.articles -%}
        {%- if other.id != article.id and count < s.count -%}
          {% render 'article-card', post: other %}
          {%- assign count = count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related posts",
  "tag": "section",
  "class": "section-related-posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "More buying guides" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    {
      "type": "range",
      "id": "count",
      "label": "Posts to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    { "name": "Related posts" }
  ]
}
{% endschema %}
