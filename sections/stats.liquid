{%- liquid
  assign s = section.settings
-%}

<section class="section section--stats" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="stats-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="stat" {{ block.shopify_attributes }}>
            <div class="stat__num">{{ block.settings.number }}</div>
            <div class="stat__label">{{ block.settings.label }}</div>
            {%- if block.settings.sub != blank -%}
              <div class="stat__sub">{{ block.settings.sub }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stats",
  "tag": "section",
  "class": "section-stats",
  "settings": [],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "50,000+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Riders"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Subtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats"
    }
  ]
}{% endschema %}