{%- liquid
  assign s = section.settings
-%}

<section class="section section--values" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="values-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'value' -%}
          <article class="value-card" {{ block.shopify_attributes }}>
            <div class="value-card__num">{{ block.settings.number | default: forloop.index }}</div>
            <h3 class="value-card__title">{{ block.settings.title }}</h3>
            <p class="value-card__text">{{ block.settings.text }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Values grid",
  "tag": "section",
  "class": "section-values",
  "settings": [],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number/label (e.g. 01)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values"
    }
  ]
}{% endschema %}
