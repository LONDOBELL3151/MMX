<div class="share" data-share>
  <span class="share__label">{{ 'general.share' | t: default: 'Share' }}:</span>
  <a class="share__btn" target="_blank" rel="noopener"
     href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: article.url | url_encode }}"
     aria-label="Share on Facebook">{% render 'icon', icon: 'facebook' %}</a>
  <a class="share__btn" target="_blank" rel="noopener"
     href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url | append: article.url | url_encode }}"
     aria-label="Share on Twitter">{% render 'icon', icon: 'twitter' %}</a>
  <a class="share__btn" target="_blank" rel="noopener"
     href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url | append: article.url | url_encode }}"
     aria-label="Share by email">{% render 'icon', icon: 'mail' %}</a>
  <button type="button" class="share__btn share__copy" data-share-copy aria-label="Copy link">
    {% render 'icon', icon: 'menu' %}
  </button>
</div>